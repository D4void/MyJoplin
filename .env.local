# .env-local for local test with localhost and no proxy
# Used with docker-compose-local.yml
#
# APP_BASE_URL=http://localhost:22300
#

JOPLIN_TAG=3.5.12
POSTGRES_TAG=16.11-alpine3.22
POSTGRES_PORT=5432
POSTGRES_USER=joplin
POSTGRES_PASSWORD=joplin
POSTGRES_DATABASE=joplin
DB_VOL=/opt/MyJoplinPostgres
DB_BACKUP_VOL=/opt/MyJoplinPostgresBackup
JOPLIN_PORT=22300
APP_BASE_URL=http://localhost:${JOPLIN_PORT}
MAILER_ENABLED=0
MAILER_HOST=smtp.domain.fr
MAILER_PORT=587
MAILER_SECURITY=starttls
MAILER_AUTH_USER=user
MAILER_AUTH_PASSWORD=password
MAILER_NOREPLY_NAME=JoplinServer
MAILER_NOREPLY_EMAIL=noreply@domain.fr
